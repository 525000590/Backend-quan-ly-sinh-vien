              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 400', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "pm.test('Response lỗi chuẩn {success:false, status:400, message, data:null}', function () {",
                  "  pm.expect(json.success).to.be.false;",
                  "  pm.expect(json.status).to.eql(400);",
                  "  pm.expect(json.data).to.be.null;",
                  "  pm.expect(Boolean(json.message)).to.be.true;",
