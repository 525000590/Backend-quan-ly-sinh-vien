        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Minh An\",\n  \"email\": \"an.lab@example.com\",\n  \"password\": \"SinhVien@123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('A01 - Status là 201', function () { pm.response.to.have.status(201); });",
            "pm.test('A01 - User có role student, không lộ hash', function () {",
            "    const b = pm.response.json();",
            "    pm.expect(b.success).to.eql(true);",
            "    pm.expect(b.data.role).to.eql('student');",
            "    pm.expect(b.data.passwordHash).to.be.undefined;",
            "});"
          ]
        }
      }]
    },
