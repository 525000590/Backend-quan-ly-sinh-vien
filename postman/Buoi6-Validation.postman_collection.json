        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"V01 - Status là 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"V01 - Sinh viên mới đúng dữ liệu\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.maSV).to.eql(\"SV006\");",
              "    pm.expect(body.data.hoTen).to.eql(\"Nguyễn Minh An\");",
              "});"
