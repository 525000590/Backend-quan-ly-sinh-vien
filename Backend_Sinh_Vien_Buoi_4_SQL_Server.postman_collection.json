  "item": [
    {
      "name": "01 - Server hoạt động (T01)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status la 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Server hoat dong dung thong diep\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.message).to.eql(\"Backend quản lý sinh viên đang hoạt động\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Danh sách sinh viên (T02)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sinh-vien"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status la 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Danh sach dung hop dong\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data).to.be.an(\"array\");",
              "    pm.expect(body.data.some(function (sv) { return sv.maSV === \"SV001\"; })).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
