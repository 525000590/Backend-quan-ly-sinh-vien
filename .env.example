# Cấu hình cổng chạy ứng dụng Backend
PORT=5000
NODE_ENV=development

# Cấu hình kết nối CSDL SQL Server
# Khi chạy cục bộ trên Windows: DB_HOST=127.0.0.1
# Khi chạy Backend trong Docker kết nối SQL Server host: DB_HOST=host.docker.internal
# Khi chạy toàn bộ qua Docker Compose: DB_HOST=sqlserver
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=QuanLySinhVienDB
DB_USER=sv_app
DB_PASSWORD="MAT_KHAU_LOCAL_CUA_BAN"
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Khóa bí mật ký mã hóa JWT Token (Không bao giờ chia sẻ công khai)
JWT_SECRET="YOUR_STRONG_JWT_SECRET_KEY_HERE"

# Mật khẩu SA cho SQL Server container (nếu chạy Docker Compose)
MSSQL_SA_PASSWORD="YourStrong@Password123"
